      <td>${escapeHtml(t.description)}</td><td>${t.date}</td><td>${t.hours}</td><td>${money(t.cost)}</td>
      <td>${escapeHtml(t.provider)}</td><td>${escapeHtml(t.attendedStatus)}</td>
