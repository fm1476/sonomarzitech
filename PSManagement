    if(f.k9!=="All" && i.k9Id!==f.k9) return false;
    if(f.type!=="All" && i.type!==f.type) return false;
    if(f.status!=="All" && i.reviewStatus!==f.status) return false;
    return true;
  }).slice().sort((a,b)=>b.date.localeCompare(a.date));

  const rows = list.map(i=>`
