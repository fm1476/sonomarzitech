            <button class="btn-icon" data-move="up" data-widget-id="${id}" title="Move up">&uarr;</button>
            <button class="btn-icon" data-move="down" data-widget-id="${id}" title="Move down">&darr;</button>
          </div>`;
        }).join('')}
      </div>
    </div>
    <div class="modal-foot"><button class="btn btn-outline" id="mCancel">Cancel</button><button class="btn btn-primary" id="mSave">Save Dashboard</button></div>
  `;
  openModal();
  document.getElementById('mClose').onclick = closeModal;
  document.getElementById('mCancel').onclick = closeModal;
  function reorder(id, dir){
    const list = document.getElementById('widgetOrderList');
    const row = list.querySelector(`.widget-order-row[data-widget-id="${id}"]`);
    if(dir==='up' && row.previousElementSibling) list.insertBefore(row, row.previousElementSibling);
    if(dir==='down' && row.nextElementSibling) list.insertBefore(row.nextElementSibling, row);
  }
  document.querySelectorAll('[data-move]').forEach(b=>b.addEventListener('click', ()=>reorder(b.dataset.widgetId, b.dataset.move)));
  document.getElementById('mSave').onclick = ()=>{
    const rows = Array.from(document.querySelectorAll('.widget-order-row'));
    const newWidgets = rows.filter(r=>r.querySelector('.widgetCheck').checked).map(r=>r.dataset.widgetId);
    prefs.widgets = newWidgets;
    logActivity(`Customized personal Grants dashboard (${newWidgets.length} widget(s) shown).`, "dashboard_prefs");
    persist();
    toast("Dashboard saved.");
    closeModal();
    renderDashboard();
  };
}

