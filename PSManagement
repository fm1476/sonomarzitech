  STATE.roles.forEach(r=>{ if(r.agencyScope===undefined) r.agencyScope = []; });
  // backfill any abilities introduced after a role was saved, so old roles don't silently lose access.
  // A locked role (System Admin is the only one) is defined as "every ability, every module" by design --
  // this is enforced unconditionally on every load, not just for newly-missing keys, so that a value
  // which was already incorrectly persisted as false (e.g. by an older build's migration bug, before
  // this self-healing check existed) gets corrected too rather than staying wrong forever.
  // One deliberate exception: vendor-only abilities (currently just manage_application_access) are
  // never auto-granted this way, even to a locked role -- that's the whole point of separating a
