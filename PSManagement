let FLEET_FILTER = {q:"", status:"All", category:"All"};
let FLEET_SORT_KEY = "name";

function renderFleet(){
  const canView = can('drone_fleet_view');
  const canEdit = can('drone_fleet_edit');
  const canDelete = can('drone_fleet_delete');
  if(!canView){
