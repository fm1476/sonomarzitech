      <div class="panel-body">
        <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(150px, 1fr));gap:12px;">
          ${fleet.map(d=>`
            <div style="border:1px solid var(--border);border-radius:8px;padding:12px;text-align:center;background:var(--lightgray);">
