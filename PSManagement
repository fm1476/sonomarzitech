/* =========================================================================
   ASK THE DATA (chatbot assistant)
   A natural-language-ish query engine over the suite's real live data, not a
   generative AI model -- there's no secure way to call a real LLM from a
   client-side-only app without exposing an API key, so this instead does
   honest intent/keyword matching against real STATE data and links straight
   back to the underlying records. Gated behind the chatbot_access ability.
   ========================================================================= */
let CHAT_HISTORY = [];
let CHAT_OPEN = false;

function updateChatToggleVisibility(){
  const btn = document.getElementById('btnChatToggle');
  if(!btn) return;
  btn.style.display = can('chatbot_access') ? '' : 'none';
  if(!can('chatbot_access')){
    CHAT_OPEN = false;
    const panel = document.getElementById('chatPanel');
    if(panel) panel.classList.remove('open');
  }
}

function toggleChatPanel(){
  if(!can('chatbot_access')) return;
  CHAT_OPEN = !CHAT_OPEN;
  document.getElementById('chatPanel').classList.toggle('open', CHAT_OPEN);
  if(CHAT_OPEN) renderChatPanel();
}

const CHAT_SUGGESTIONS = [
  "Who is not in compliance with range training?",
  "Which vehicles are out of service?",
  "What equipment is overdue for return?",
  "Which K9s are below training compliance?",
  "Which drones are grounded?",
  "Any open theft or loss reports?",
];

function renderChatPanel(){
  const panel = document.getElementById('chatPanel');
  panel.innerHTML = `
    <div class="chat-head">
      <div><h3>Ask the Data</h3><div class="sub">Query your live records in plain English</div></div>
      <button class="modal-close" id="btnChatClose">&times;</button>
    </div>
    <div class="chat-messages" id="chatMessages"></div>
    <div class="chat-input-row">
      <input type="text" id="chatInput" placeholder="Ask a question about your data...">
      <button class="btn btn-primary btn-sm" id="btnChatSend">Send</button>
    </div>
  `;
  document.getElementById('btnChatClose').addEventListener('click', toggleChatPanel);
  document.getElementById('btnChatSend').addEventListener('click', sendChatMessage);
  document.getElementById('chatInput').addEventListener('keydown', (e)=>{ if(e.key==='Enter') sendChatMessage(); });
  renderChatMessages();
  document.getElementById('chatInput').focus();
}

function renderChatMessages(){
  const box = document.getElementById('chatMessages');
  if(!box) return;
  if(CHAT_HISTORY.length===0){
    box.innerHTML = `
      <div class="chat-empty-state">
        ${ICONS.history}
        <div style="font-weight:700;color:var(--heading);margin-bottom:4px;">Ask about anything in the suite</div>
        <div style="font-size:12px;">Try one of these, or ask your own question:</div>
      </div>
      <div class="chat-suggestions">${CHAT_SUGGESTIONS.map(s=>`<button class="chat-suggestion-chip" data-suggest="${escapeHtml(s)}">${escapeHtml(s)}</button>`).join('')}</div>
    `;
    box.querySelectorAll('[data-suggest]').forEach(b=>b.addEventListener('click', ()=>{
      document.getElementById('chatInput').value = b.dataset.suggest;
      sendChatMessage();
    }));
    return;
  }
  box.innerHTML = CHAT_HISTORY.map((m,i)=>`
    <div class="chat-msg ${m.role}">
      <div class="chat-bubble">${escapeHtml(m.text)}</div>
      ${m.results && m.results.length ? `<div class="chat-results" data-msg-idx="${i}">
        ${m.results.map((r,ri)=>`<a href="#" class="chat-result-row" data-result="${i}:${ri}"><div><div class="r-main">${escapeHtml(r.title)}</div>${r.sub?`<div class="r-sub">${escapeHtml(r.sub)}</div>`:''}</div><span style="color:var(--text-dim);">&rarr;</span></a>`).join('')}
      </div>` : ''}
    </div>
  `).join('');
  box.querySelectorAll('[data-result]').forEach(a=>a.addEventListener('click', (ev)=>{
    ev.preventDefault();
    const [msgIdx, resultIdx] = a.dataset.result.split(':').map(Number);
    const result = CHAT_HISTORY[msgIdx].results[resultIdx];
    if(result.onClick) result.onClick();
  }));
  box.scrollTop = box.scrollHeight;
}

function sendChatMessage(){
  const input = document.getElementById('chatInput');
  const text = input.value.trim();
  if(!text) return;
  CHAT_HISTORY.push({role:'user', text});
  const answer = answerChatQuery(text);
  CHAT_HISTORY.push({role:'bot', text: answer.text, results: answer.results});
  input.value = '';
  renderChatMessages();
}

function chatGoTo(moduleKey, viewId, openFn){
  return ()=>{
    toggleChatPanel();
    if(ACTIVE_MODULE !== moduleKey) enterModule(moduleKey);
    const mod = {qm:QM, fleet:FLEET, personnel:PM, k9:K9, drone:DRONE, eod:EOD}[moduleKey];
    if(mod && viewId) mod.switchView(viewId);
    if(openFn) setTimeout(openFn, 60);
  };
}

// Words that flip the sense of a status filter (e.g. "who is NOT compliant")
const CHAT_NEGATION_WORDS = ['not','isn\'t','aren\'t','no ','never','lacking','missing','without','fail','failed','failing','non-compliant','noncompliant'];
function chatIsNegated(q){ return CHAT_NEGATION_WORDS.some(w=>q.includes(w)); }
// Some entity words are almost never ambiguous ("magazine", "k9") and deserve a stronger signal
// than moderately-specific ones ("inspection" legitimately means different things in Fleet vs. EOD).
function chatScore(q, topic){
  let score = keywordHits(q, topic.keywords||[]);
  if(topic.entityKeywords && keywordHits(q, topic.entityKeywords) > 0) score += 10;
  if(topic.strongKeywords && keywordHits(q, topic.strongKeywords) > 0) score += 20;
  return score;
}
function keywordHits(q, keywords){ return keywords.reduce((s,k)=>s + (q.includes(k)?1:0), 0); }

/* Each topic: keywords to match the question to it, and a handler that returns {text, results}.
   Handlers read directly from STATE so answers are always the real live data, never canned text. */
const CHAT_TOPICS = [
  // ---------- Personnel Management: required training compliance ----------
  {
    entityKeywords: ['employee','officer','personnel','staff'], keywords: ['training','compliance','compliant','certification','certified','qualification','qualified','range','required training'],
    minAbility: 'pm_reports_view',
    handler(q){
      if(!STATE.pm) return null;
      // Real-world terminology doesn't always match the formal catalog name -- "range training"
      // and "firearms qualification" mean the same thing to an actual police department, for example.
      const courseSynonyms = [
        [['range','firearm','firearms','qualification','qualif'], 'firearms qualification'],
        [['defensive tactic','dt ','use of force'], 'defensive tactics'],
        [['cpr','first aid'], 'cpr / first aid'],
        [['taser','less-lethal','less lethal'], 'taser'],
        [['ncic','records'], 'ncic'],
        [['evoc','driving','pursuit'], 'emergency vehicle'],
        [['legal update','case law'], 'legal update'],
        [['crisis intervention','ci training'], 'crisis intervention'],
        [['supervisor','leadership'], 'supervisor leadership'],
      ];
      const matchedSynonym = courseSynonyms.find(([triggers])=>triggers.some(t=>q.includes(t)));
      const courseWord = matchedSynonym ? matchedSynonym[1].split(' ')[0] : null;
      let required = STATE.pm.trainingCourses.filter(c=>c.isRequired);
      if(courseWord) required = required.filter(c=>c.name.toLowerCase().includes(courseWord));
      if(required.length===0) return {text:"I couldn't find a required course matching that in the Personnel Management course catalog.", results:[]};
      const negated = !q.includes('who is compliant') && !q.includes('who has completed');
      const active = STATE.pm.records.filter(r=>r.employmentStatus==='Active');
      const results = [];
      active.forEach(r=>{
        const missing = required.filter(c=>!STATE.pm.trainingRecords.some(t=>t.personId===r.personId && t.courseId===c.id && t.passed!==false));
        const isCompliant = missing.length===0;
        if((negated && !isCompliant) || (!negated && isCompliant)){
          results.push({ title: personName(r.personId), sub: isCompliant?'Complete':`Missing: ${missing.map(c=>c.name).join(', ')}`,
            onClick: chatGoTo('personnel', 'pm-records', ()=>PM.openRecordDetail(r.personId)) });
        }
      });
      const courseLabel = courseWord ? required.map(c=>c.name).join(', ') : 'required training';
      return {
        text: results.length
          ? `${results.length} active employee(s) ${negated?'are not in compliance with':'are compliant with'} ${courseLabel}:`
          : `Good news \u2014 no active employees are ${negated?'out of compliance with':'compliant with (none found)'} ${courseLabel}.`,
        results,
      };
    },
  },
  // ---------- Fleet: vehicle status ----------
  {
    entityKeywords: ['vehicle','vehicles','car','cars'], keywords: ['fleet','out of service','in service'],
    minAbility: 'fleet_vehicle_view',
    handler(q){
      if(!STATE.fleet) return null;
      let statusFilter = null;
      if(q.includes('out of service')) statusFilter = 'Out of Service';
      else if(q.includes('maintenance')) statusFilter = 'In Maintenance';
      else if(q.includes('in service') || q.includes('available')) statusFilter = 'In Service';
      const list = statusFilter ? STATE.fleet.vehicles.filter(v=>v.status===statusFilter) : STATE.fleet.vehicles;
      const results = list.map(v=>({
        title: `${v.year} ${v.make} ${v.model} \u2014 ${v.unitNumber}`, sub: `${v.status} \u2014 ${escapeHtml ? v.assignedTo||'Unassigned' : ''}`,
        onClick: chatGoTo('fleet', 'fleet-vehicles', ()=>FLEET.openVehicleDetail(v.id)),
      }));
      return {
        text: statusFilter ? `${results.length} vehicle(s) are currently ${statusFilter}:` : `${results.length} vehicle(s) in the fleet:`,
        results,
      };
    },
  },
  // ---------- Fleet: inspections overdue ----------
  {
    entityKeywords: ['inspection','inspections'], keywords: ['overdue inspection'],
    minAbility: 'fleet_vehicle_view',
    handler(q){
      if(!STATE.fleet) return null;
      const overdue = STATE.fleet.vehicles.filter(v=>{
        const lastInsp = STATE.fleet.inspections.filter(i=>i.vehicleId===v.id).sort((a,b)=>b.dateTime.localeCompare(a.dateTime))[0];
        return !lastInsp || daysBetween(lastInsp.dateTime.split('T')[0], fmt(new Date())) > 90;
      });
      return {
        text: `${overdue.length} vehicle(s) have no inspection on file within the last 90 days:`,
        results: overdue.map(v=>({ title:`${v.year} ${v.make} ${v.model} \u2014 ${v.unitNumber}`, sub:'Inspection overdue', onClick: chatGoTo('fleet','fleet-vehicles', ()=>FLEET.openVehicleDetail(v.id)) })),
      };
    },
  },
  // ---------- Quartermaster: equipment status / overdue / low stock ----------
  {
    entityKeywords: ['equipment','gear'], keywords: ['overdue','return','low stock','stock','inventory'],
    minAbility: 'qm_equip_view',
    handler(q){
      if(!STATE.qm) return null;
      if((q.includes('low') && q.includes('stock')) || q.includes('running low')){
        const low = STATE.qm.equipment.filter(e=>e.isConsumable && e.minQuantity!=null && e.quantity<=e.minQuantity);
        return { text: `${low.length} consumable item(s) are at or below their reorder threshold:`,
          results: low.map(e=>({ title:e.name, sub:`${e.quantity} on hand (reorder at ${e.minQuantity})`, onClick: chatGoTo('qm','qm-inventory', ()=>QM.openEquipmentDetail(e.id)) })) };
      }
      if(q.includes('overdue') || q.includes('not been returned') || q.includes('return')){
        const overdue = STATE.qm.assignments.filter(a=>a.status==='Overdue');
        return { text: `${overdue.length} checked-out item(s) are overdue for return:`,
          results: overdue.map(a=>{ const eq = STATE.qm.equipment.find(e=>e.id===a.equipmentId); return { title: eq?eq.name:'Unknown item', sub:`Checked out to ${a.personId?personName(a.personId):(a.targetId||'a unit')}, due ${a.dueDate}`, onClick: chatGoTo('qm','qm-assignments', ()=>eq&&QM.openEquipmentDetail(eq.id)) }; }) };
      }
      let statusFilter = null;
      ['Missing','Lost','Stolen','Destroyed','Maintenance','Retired','Available','Assigned'].forEach(s=>{ if(q.includes(s.toLowerCase())) statusFilter = s; });
      const list = statusFilter ? STATE.qm.equipment.filter(e=>e.status===statusFilter) : [];
      if(!statusFilter) return null;
      return { text: `${list.length} equipment item(s) with status "${statusFilter}":`,
        results: list.map(e=>({ title:e.name, sub:`Status: ${e.status}`, onClick: chatGoTo('qm','qm-inventory', ()=>QM.openEquipmentDetail(e.id)) })) };
    },
  },
  // ---------- K9: training compliance / certifications / incidents ----------
  {
    entityKeywords: ['k9','dog','dogs','canine'], keywords: ['training','compliance','compliant','cert','incident'],
    minAbility: 'k9_roster_view',
    handler(q){
      if(!STATE.k9) return null;
      if(q.includes('training') || q.includes('compliance') || q.includes('compliant')){
        const negated = chatIsNegated(q) || q.includes('below');
        const results = STATE.k9.k9s.filter(k=>k.status!=="Retired" && k.status!=="Deceased").map(k=>{
          const hrs = K9.monthlyTrainingHours(k.id,1);
          return {k, hrs, compliant: hrs >= K9.MONTHLY_TRAINING_HOURS_STANDARD};
        }).filter(x=>negated ? !x.compliant : x.compliant)
          .map(x=>({ title:x.k.name, sub:`${x.hrs}h / ${K9.MONTHLY_TRAINING_HOURS_STANDARD}h this month \u2014 Handler: ${personName(x.k.handlerId)}`, onClick: chatGoTo('k9','k9-roster', ()=>K9.openK9Detail(x.k.id)) }));
        return { text: `${results.length} K9(s) are ${negated?'below':'meeting'} the ${K9.MONTHLY_TRAINING_HOURS_STANDARD}-hour monthly training standard:`, results };
      }
      if(q.includes('cert') || q.includes('expir')){
        const today = fmt(new Date());
        const expiring = STATE.k9.certifications.filter(c=>c.expirationDate && daysBetween(today, c.expirationDate) <= 45);
        return { text: `${expiring.length} K9 certification(s) expire within 45 days:`,
          results: expiring.map(c=>({ title:`${(K9.k9For(c.k9Id)||{}).name||'Unknown'} \u2014 ${c.certType}`, sub:`Expires ${c.expirationDate}`, onClick: chatGoTo('k9','k9-certifications', ()=>K9.openK9Detail(c.k9Id)) })) };
      }
      if(q.includes('incident')){
        const pending = STATE.k9.incidents.filter(i=>i.reviewStatus==='Pending');
        return { text: `${pending.length} K9 incident(s) are pending review:`,
          results: pending.map(i=>({ title:`${(K9.k9For(i.k9Id)||{}).name||'Unknown'} \u2014 ${i.type}`, sub:i.date, onClick: chatGoTo('k9','k9-incidents', ()=>K9.openK9Detail(i.k9Id)) })) };
      }
      return { text: `There are ${STATE.k9.k9s.length} K9s on the roster. Try asking about their training compliance, certifications, or incidents.`, results: [] };
    },
  },
  // ---------- Drone: status / Part 107 / incidents ----------
  {
    entityKeywords: ['drone','drones','aircraft','uas'], keywords: ['pilot','part 107','ground','maintenance','status','cert','expir','incident'],
    minAbility: 'drone_fleet_view',
    handler(q){
      if(!STATE.drone) return null;
      if(q.includes('ground') || q.includes('maintenance') || q.includes('status')){
        let statusFilter = q.includes('ground') ? 'Grounded' : (q.includes('maintenance') ? 'Maintenance' : null);
        const list = statusFilter ? STATE.drone.drones.filter(d=>d.status===statusFilter) : STATE.drone.drones;
        return { text: statusFilter ? `${list.length} aircraft are currently ${statusFilter}:` : `${list.length} aircraft in the fleet:`,
          results: list.map(d=>({ title:d.name, sub:`${d.model} \u2014 ${d.status}`, onClick: chatGoTo('drone','drone-fleet', ()=>DRONE.openDroneDetail(d.id)) })) };
      }
      if(q.includes('107') || q.includes('cert') || q.includes('expir') || q.includes('pilot')){
        const negated = chatIsNegated(q);
        const results = STATE.drone.operators.filter(o=>negated ? !DRONE.operatorCurrent(o) : DRONE.operatorCurrent(o))
          .map(o=>({ title:personName(o.personId), sub:`Part 107 ${o.certExpiration||'unknown'}`, onClick: chatGoTo('drone','drone-operators', ()=>DRONE.openOperatorDetail(o.personId)) }));
        return { text: `${results.length} operator(s) have a ${negated?'lapsed or expiring':'current'} Part 107 certificate:`, results };
      }
      if(q.includes('incident')){
        const pending = STATE.drone.incidents.filter(i=>i.reviewStatus==='Pending');
        return { text: `${pending.length} drone incident(s) are pending review:`,
          results: pending.map(i=>({ title:`${(DRONE.droneFor(i.droneId)||{}).name||'Unknown'} \u2014 ${i.type}`, sub:i.date, onClick: chatGoTo('drone','drone-incidents', ()=>DRONE.openDroneDetail(i.droneId)) })) };
      }
      return { text: `There are ${STATE.drone.drones.length} aircraft in the fleet. Try asking which are grounded, which operators' Part 107 is expiring, or about incidents.`, results: [] };
    },
  },
  // ---------- EOD: technicians / magazines / theft-loss ----------
  {
    entityKeywords: ['eod','bomb technician'], strongKeywords: ['bomb squad','explosive','hds','magazine'], keywords: ['technician','theft','loss','recert'],
    minAbility: 'eod_technician_view',
    handler(q){
      if(!STATE.eod) return null;
      if(q.includes('theft') || q.includes('loss')){
        const open = STATE.eod.theftLossReports.filter(r=>!r.reportedAtfDate);
        return { text: open.length ? `${open.length} theft/loss report(s) are still open and awaiting ATF filing:` : "No open theft/loss reports \u2014 as it should be.",
          results: open.map(r=>({ title:`${r.materialInvolved} \u2014 ${r.quantityLost}`, sub:`Discovered ${r.discoveredDate}`, onClick: chatGoTo('eod','eod-theftloss') })) };
      }
      if(q.includes('magazine') || q.includes('inspect')){
        const overdue = STATE.eod.magazines.filter(m=>daysBetween(m.lastInspectionDate, fmt(new Date())) > EOD.MAGAZINE_INSPECTION_DAYS);
        return { text: `${overdue.length} magazine(s) are overdue for their ${EOD.MAGAZINE_INSPECTION_DAYS}-day inspection:`,
          results: overdue.map(m=>({ title:m.name, sub:`Last inspected ${m.lastInspectionDate}`, onClick: chatGoTo('eod','eod-magazines', ()=>EOD.openMagazineDetail(m.id)) })) };
      }
      const negated = chatIsNegated(q) || q.includes('recert') || q.includes('due');
      const results = STATE.eod.technicians.filter(t=>negated ? !EOD.technicianCurrent(t) : EOD.technicianCurrent(t))
        .map(t=>({ title:personName(t.personId), sub:`HDS recert due ${t.hdsRecertDueDate}`, onClick: chatGoTo('eod','eod-technicians', ()=>EOD.openTechDetail(t.personId)) }));
      return { text: `${results.length} technician(s) ${negated?'need HDS recertification':'are current on HDS certification'}:`, results };
    },
  },
];

function answerChatQuery(rawText){
  const q = rawText.toLowerCase();
  let best = null, bestScore = 0;
  CHAT_TOPICS.forEach(topic=>{
    if(topic.minAbility && !can(topic.minAbility)) return;
    const score = chatScore(q, topic);
    if(score > bestScore){ bestScore = score; best = topic; }
  });
  if(!best || bestScore===0){
    return { text: "I'm not sure how to match that to your data yet. Try asking about training compliance, vehicle or equipment status, K9 or drone readiness, or EOD compliance \u2014 or tap one of the suggestions below.", results: [] };
  }
  const answer = best.handler(q);
  if(!answer) return { text: "I recognized the topic but couldn't find that data in your current role's view.", results: [] };
  return answer;
}

