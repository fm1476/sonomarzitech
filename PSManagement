      <div class="stat-card"><div class="label">Certifications Expiring</div><div class="value" style="color:${certsExpiring?'var(--red)':'var(--heading)'}">${certsExpiring}</div><div class="delta ${certsExpiring?'warn':'ok'}">Within 45 days</div></div>
      <div class="stat-card"><div class="label">Flights (30 days)</div><div class="value">${last30Flights}</div><div class="delta neutral">${STATE.drone.flights.length} total on file</div></div>
    </div>
    <div class="panel" style="margin-bottom:16px;">
