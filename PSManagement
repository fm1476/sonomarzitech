    const byPhase = {}; CASH_PHASES.forEach(p=>byPhase[p]=0);
    cashSeizures.forEach(s=>{ byPhase[currentCashPhase(s)] = (byPhase[currentCashPhase(s)]||0) + currentCashAmount(s); });
